{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "google-analytics-mcp-template",
  "main": "src/ga-worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "env": {
    "layal": {
      "name": "layal-google-analytics-mcp",
      "vars": {
        "BRAND_SLUG": "layal",
        "BRAND_LABEL": "Layal Dress",
        "BRAND_SITE_URL": "https://layaldress.com/",
        "GA_ACCOUNT_ID": "387714621",
        "GA_ACCOUNT_NAME": "فساتين ليال",
        "GA_PROPERTY_ID": "528542206",
        "GSC_SITE_URL": ""
      },
      "kv_namespaces": [{
        "binding": "OAUTH_KV",
        "id": "548907c4626242a6938a7932bc8e1a99"
      }]
    },
    "toleen": {
      "name": "toleen-google-analytics-mcp",
      "vars": {
        "BRAND_SLUG": "toleen",
        "BRAND_LABEL": "Toleen Fashion",
        "BRAND_SITE_URL": "https://toleen-fashion22.com/",
        "GA_ACCOUNT_ID": "375645449",
        "GA_ACCOUNT_NAME": "toleen-fashion22.com",
        "GA_PROPERTY_ID": "513746872",
        "GSC_SITE_URL": ""
      },
      "kv_namespaces": [{
        "binding": "OAUTH_KV",
        "id": "89b77d03fa4d40b080a493bf5b43c4b6"
      }]
    },
    "asom": {
      "name": "asom-google-analytics-mcp",
      "vars": {
        "BRAND_SLUG": "asom",
        "BRAND_LABEL": "Asom Fashion",
        "BRAND_SITE_URL": "",
        "GA_ACCOUNT_ID": "",
        "GA_ACCOUNT_NAME": "",
        "GA_PROPERTY_ID": "",
        "GSC_SITE_URL": ""
      },
      "kv_namespaces": [{
        "binding": "OAUTH_KV",
        "id": "REPLACE_WITH_ASOM_GA_OAUTH_KV_ID"
      }]
    }
  }
}
